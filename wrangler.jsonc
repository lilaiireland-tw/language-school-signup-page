{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-creator-vinext-starter",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "images": {
    "binding": "IMAGES"
  },
  "ratelimits": [
    {
      "name": "APPLICATION_RATE_LIMITER",
      "namespace_id": "76082801",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lilai-applications-production",
      "database_id": "d7b4209c-fce2-4f0d-9b18-3f19c183b430",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INTEGRATION_QUEUE",
        "queue": "lilai-application-integrations"
      }
    ],
    "consumers": [
      {
        "queue": "lilai-application-integrations",
        "dead_letter_queue": "lilai-application-integrations-dlq",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 60
      }
    ]
  },
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  },
  "vars": {
    "EMAIL_REPLY_TO": "lilaiireland@gmail.com",
    "INTERNAL_NOTIFICATION_EMAIL": "lilaiireland@gmail.com",
    "NOTION_VERSION": "2022-06-28"
  },
  "secrets": {
    "required": [
      "ADMIN_API_TOKEN",
      "GMAIL_CLIENT_ID",
      "GMAIL_CLIENT_SECRET",
      "GMAIL_REFRESH_TOKEN",
      "GMAIL_SENDER_EMAIL",
      "NOTION_TOKEN",
      "NOTION_DATABASE_ID",
      "TURNSTILE_SECRET",
      "TURNSTILE_SITE_KEY",
      "TURNSTILE_HOSTNAMES"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging": {
      "name": "site-creator-vinext-starter-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lilai-applications-staging",
          "database_id": "370f3f4a-a1dd-40d7-8e2d-097fe835747f",
          "migrations_dir": "migrations"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "INTEGRATION_QUEUE",
            "queue": "lilai-application-integrations-staging"
          }
        ],
        "consumers": []
      },
      "triggers": {
        "crons": []
      },
      "images": {
        "binding": "IMAGES"
      },
      "ratelimits": [
        {
          "name": "APPLICATION_RATE_LIMITER",
          "namespace_id": "76082802",
          "simple": {
            "limit": 30,
            "period": 60
          }
        }
      ],
      "secrets": {
        "required": []
      },
      "vars": {
        "EMAIL_REPLY_TO": "lilaiireland@gmail.com",
        "INTERNAL_NOTIFICATION_EMAIL": "lilaiireland@gmail.com",
        "NOTION_VERSION": "2022-06-28",
        "NEXT_PUBLIC_NOINDEX": "true"
      }
    }
  },
  // "kv_namespaces": [
  //   {
  //     "binding": "VINEXT_KV_CACHE",
  //     "id": "<your-kv-namespace-id>"
  //   }
  // ]
}
