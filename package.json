{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run test:gmail && npm run build && node --test tests/rendered-html.test.mjs",
    "test:gmail": "node --experimental-strip-types --test tests/gmail-oauth.test.ts tests/student-confirmation-email.test.ts",
    "test:frontend-review": "node --experimental-strip-types --test tests/frontend-business-logic.test.ts",
    "gmail:authorize": "node scripts/generate-gmail-refresh-token.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply lilai-applications-production --local",
    "db:migrate:remote": "wrangler d1 migrations apply lilai-applications-production --remote",
    "db:backup": "wrangler d1 export lilai-applications-production --remote --output backups/lilai-applications-production.sql",
    "types:worker": "wrangler types worker-configuration.d.ts",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json --experimental-warm-cdn-cache"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.6",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.25.0",
    "next": "^16.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.7",
    "vite": "^8.2.1",
    "wrangler": "^4.124.0"
  },
  "type": "module"
}
